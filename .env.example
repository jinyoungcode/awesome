# 복사해서 .env 로 쓰세요. .env 는 .gitignore 로 커밋이 막혀 있습니다.
# 실제 값은 절대 이 파일(.env.example)에 적지 마세요.

# 운용 모드: backtest | paper   (live 는 대표 승인 전까지 코드에서 차단됨)
STOCKKING_MODE=paper

# 한국투자증권(KIS) 모의투자 앱키 — 모의투자 전용 키만 사용
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
# 모의투자 계좌번호 앞 8자리 / 상품코드 2자리
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PRODUCT=01

# 킬스위치 파일 경로 (파일이 존재하면 모든 신규 주문 차단)
STOCKKING_KILL_SWITCH_FILE=var/KILL_SWITCH
